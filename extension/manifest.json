{
  "manifest_version": 3,
  "name": "Video Ledger",
  "version": "0.1.0",
  "key": "",
  "description": "Local YouTube and Bilibili history, only for sessions you launch.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "unlimitedStorage", "scripting", "webNavigation", "nativeMessaging"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.bilibili.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Video Ledger — history and setup" },
  "options_page": "dashboard.html"
}
